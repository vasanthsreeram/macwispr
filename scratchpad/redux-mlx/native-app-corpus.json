      "text": "The meeting starts at 9 tomorrow morning. Please send the final report before Friday."
    },
    {
      "app_peak_rss_bytes": 84148224,
      "backend_memory": {
        "active_gpu_bytes": 220515778,
        "backend": "redux-mlx",
        "cache_gpu_bytes": 92535987,
