      "runtime": "redux-mlx",
      "seconds": 0.4759230613708496,
      "text": "On Saturday mornings when the sodality met in the chapel to recite the little office, his place was a cushioned kneeling desk at the right of the altar, from which he led his wing of boys through the responses."
    },
    {
      "app_peak_rss_bytes": 88211456,
      "backend_memory": {
        "active_gpu_bytes": 220515778,
        "backend": "redux-mlx",
        "cache_gpu_bytes": 731169373,
